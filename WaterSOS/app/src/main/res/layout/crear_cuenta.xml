<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.CrearCuenta">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/degradado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="323dp"
            android:layout_height="615dp"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="177dp"
                android:layout_height="108dp"
                android:layout_marginBottom="40dp"
                android:background="@android:drawable/zoom_plate"
                app:srcCompat="@mipmap/trabajando"
                tools:srcCompat="@mipmap/trabajando" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Crear Cuenta"
                android:textColor="@color/design_default_color_on_primary"
                android:textColorHighlight="@color/design_default_color_on_secondary"
                android:textColorHint="@color/design_default_color_on_secondary"
                android:textSize="30sp" />

            <EditText
                android:id="@+id/edtUsuario"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="@android:color/background_light"
                android:drawableLeft="@mipmap/user"
                android:ems="10"
                android:hint=" Usuario"
                android:inputType="textPersonName"
                android:paddingLeft="30dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textColorHighlight="@color/design_default_color_on_secondary"
                android:textColorHint="@color/design_default_color_primary_dark" />

            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="@android:color/background_light"
                android:drawableLeft="@mipmap/name"
                android:ems="10"
                android:hint=" Nombre Completo"
                android:inputType="textPersonName"
                android:paddingLeft="30dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textColorHint="@color/design_default_color_primary_dark" />

            <EditText
                android:id="@+id/edtCorreo"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="@android:color/background_light"
                android:drawableLeft="@mipmap/email"
                android:ems="10"
                android:hint=" Correo"
                android:inputType="textPersonName"
                android:paddingLeft="30dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textColorHighlight="@color/design_default_color_on_secondary"
                android:textColorHint="@color/design_default_color_primary_dark" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="61dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="@android:color/background_light"
                android:drawableLeft="@mipmap/padlock"
                android:ems="10"
                android:hint=" Password"
                android:inputType="textPassword"
                android:paddingLeft="30dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textColorHighlight="@color/design_default_color_on_secondary"
                android:textColorHint="@color/design_default_color_primary_dark" />

            <EditText
                android:id="@+id/edtPassword2"
                android:layout_width="match_parent"
                android:layout_height="61dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="@android:color/background_light"
                android:drawableLeft="@mipmap/password"
                android:ems="10"
                android:hint=" Repetir Password"
                android:inputType="textPassword"
                android:paddingLeft="30dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textColorHighlight="@color/design_default_color_on_secondary"
                android:textColorHint="@color/design_default_color_primary_dark" />

            <Button
                android:id="@+id/btnCuenta"
                android:layout_width="302dp"
                android:layout_height="48dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="15dp"
                android:background="@android:drawable/progress_horizontal"
                android:backgroundTint="@color/toolbar"
                android:drawableStart="@drawable/agregar_usuario"
                android:paddingLeft="45dp"
                android:paddingRight="40dp"
                android:text="Crear Cuenta"
                android:textColor="#FFF"
                android:textSize="18sp" />

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>